<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 по умолчанию, тянется в обе стороны.
  updatePeriodMillis = 0: обновляемся только по данным из Flutter и через
  собственный AlarmManager на границах уроков.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/schedule_widget"
    android:previewLayout="@layout/schedule_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
