<?xml version="1.0" encoding="utf-8"?>
<!--
  Нативный виджет расписания Hash.
  Восемь фиксированных строк: RemoteViews не умеет динамически создавать
  элементы, поэтому лишние строки просто скрываются в провайдере.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/widget_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_title"
            android:textColor="@color/widget_text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="@color/widget_text_muted"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_0"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/row_0_name"
            style="@style/WidgetRowName" />

        <TextView
            android:id="@+id/row_0_time"
            style="@style/WidgetRowTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_1"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/row_1_name"
            style="@style/WidgetRowName" />

        <TextView
            android:id="@+id/row_1_time"
            style="@style/WidgetRowTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_2"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/row_2_name"
            style="@style/WidgetRowName" />

        <TextView
            android:id="@+id/row_2_time"
            style="@style/WidgetRowTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_3"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/row_3_name"
            style="@style/WidgetRowName" />

        <TextView
            android:id="@+id/row_3_time"
            style="@style/WidgetRowTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_4"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/row_4_name"
            style="@style/WidgetRowName" />

        <TextView
            android:id="@+id/row_4_time"
            style="@style/WidgetRowTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_5"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/row_5_name"
            style="@style/WidgetRowName" />

        <TextView
            android:id="@+id/row_5_time"
            style="@style/WidgetRowTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_6"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/row_6_name"
            style="@style/WidgetRowName" />

        <TextView
            android:id="@+id/row_6_time"
            style="@style/WidgetRowTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_7"
        style="@style/WidgetRow">

        <TextView
            android:id="@+id/row_7_name"
            style="@style/WidgetRowName" />

        <TextView
            android:id="@+id/row_7_time"
            style="@style/WidgetRowTime" />
    </LinearLayout>
</LinearLayout>
